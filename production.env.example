# 🔐 Variables d'Environnement Production - Katiopa MVP
# Copiez ce fichier vers .env.production et remplissez vos vraies valeurs

# ==============================================
# 🌐 CONFIGURATION DOMAINE
# ==============================================
DOMAIN_NAME=votredomaine.com
FRONTEND_URL=https://votredomaine.com
BACKEND_URL=https://api.votredomaine.com

# ==============================================
# 🗄️ BASE DE DONNÉES
# ==============================================
DATABASE_NAME=katiopa_db
DATABASE_USER=katiopa_user
DATABASE_PASSWORD=VOTRE_MOT_DE_PASSE_DB_TRES_SECURISE
DATABASE_URL=postgresql://katiopa_user:VOTRE_MOT_DE_PASSE_DB_TRES_SECURISE@postgres:5432/katiopa_db

# ==============================================
# 🔑 JWT ET SÉCURITÉ
# ==============================================
JWT_SECRET=VOTRE_JWT_SECRET_TRES_LONG_ET_ALEATOIRE_64_CARACTERES_MINIMUM
COOKIE_SECRET=VOTRE_COOKIE_SECRET_TRES_LONG_ET_ALEATOIRE_64_CARACTERES

# ==============================================
# 🤖 OPENAI API
# ==============================================
OPENAI_API_KEY=sk-proj-VOTRE_CLE_OPENAI_ICI

# ==============================================
# 📧 CONFIGURATION EMAIL (Optionnel)
# ==============================================
# Email noreply (notifications automatiques)
NOREPLY_EMAIL_USER=noreply@votredomaine.com
NOREPLY_EMAIL_PASSWORD=votre_mot_de_passe_email
NOREPLY_SMTP_SERVER=smtp.gmail.com
NOREPLY_SMTP_PORT=587

# Email support (assistance utilisateur)
SUPPORT_EMAIL_USER=support@votredomaine.com
SUPPORT_EMAIL_PASSWORD=votre_mot_de_passe_email
SUPPORT_SMTP_SERVER=smtp.gmail.com
SUPPORT_SMTP_PORT=587

# Email hello (communication générale)
HELLO_EMAIL_USER=hello@votredomaine.com
HELLO_EMAIL_PASSWORD=votre_mot_de_passe_email
HELLO_SMTP_SERVER=smtp.gmail.com
HELLO_SMTP_PORT=587

# ==============================================
# 🏗️ CONFIGURATION SERVEUR
# ==============================================
NODE_ENV=production
PORT=4000

# ==============================================
# 🔒 SSL CONFIGURATION
# ==============================================
SSL_CERT_PATH=/etc/ssl/certs/katiopa.crt
SSL_KEY_PATH=/etc/ssl/certs/katiopa.key

# ==============================================
# 📊 MONITORING (Optionnel)
# ==============================================
SENTRY_DSN=votre_sentry_dsn_si_vous_utilisez_sentry
LOG_LEVEL=info

# ==============================================
# 🚀 INSTRUCTIONS DE DÉPLOIEMENT
# ==============================================
# 1. Copiez ce fichier: cp production.env.example .env.production
# 2. Remplissez toutes les valeurs avec vos vraies informations
# 3. Générez des secrets sécurisés:
#    - JWT_SECRET: openssl rand -hex 64
#    - COOKIE_SECRET: openssl rand -hex 64
#    - DATABASE_PASSWORD: openssl rand -base64 32
# 4. Configurez vos DNS pour pointer vers votre serveur
# 5. Lancez: docker-compose -f docker-compose.prod.yml up -d

